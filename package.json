{
  "name": "attn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "attn": "tsx packages/core/src/cli.ts",
    "api": "pnpm --filter @attn/api start",
    "web": "pnpm --filter @attn/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
