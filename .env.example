# Copy to .env and fill in. Secrets live only in the environment, never in data/.
DATABASE_URL=postgres://attn:attn@localhost:5432/attn
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google AI Studio key (free tier). Only public article text is sent to the model.
GOOGLE_GENERATIVE_AI_API_KEY=
# Chosen by eval, not by default: run `pnpm attn eval --model <id>` (README, Evaluation) and put the winner here.
# Candidates with a free tier on 2026-10-14: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-2.5-flash.
LABEL_MODEL=
# Browser-facing origin of the site. The GitHub OAuth callback URL is ${APP_URL}/api/auth/github/callback (README).
APP_URL=http://localhost:3000
# Optional (see README):
# PORT=3001                   # api port (default 3001)
# COOKIE_SECURE=false         # session cookies are Secure by default; set false ONLY for local plain-http dev (api logs a warning)
# SCHEDULE_ENABLED=true       # set false to disable the daily collect+label job
# API_URL=http://localhost:3001   # read by apps/web (put it in the web's environment, not only here)
